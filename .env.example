# Copy to .env. Every value here is optional for local use: with no .env at
# all the app runs on SQLite and accepts the built in development key
# "dev-local-key". None of the values below are real secrets.

# dev | production. In production the app refuses to start without OPS_API_KEYS.
APP_ENV=dev

# SQLite for the demo. For Postgres install requirements-postgres.txt and use
# DATABASE_URL=postgresql://ops:change-me@localhost:5432/ops
DATABASE_URL=sqlite:///./data/ops.db

# Comma separated name:key pairs. Prefer the hashed form printed by
# "python -m app genkey" so the raw key never sits on the server:
# OPS_API_KEYS=crm:sha256:<64 hex characters>,forms:sha256:<64 hex characters>
OPS_API_KEYS=local:replace-with-a-long-random-key

# Logging: json (one object per line) or text (easier to read locally).
LOG_LEVEL=INFO
LOG_FORMAT=json

# Background jobs. Set WORKER_ENABLED=false on the API and run
# "python -m app worker" separately if you want a dedicated worker process.
WORKER_ENABLED=true
WORKER_POLL_SECONDS=1
JOB_MAX_ATTEMPTS=4
JOB_BACKOFF_SECONDS=5
JOB_VISIBILITY_TIMEOUT_SECONDS=300

# Optional. Leave empty and high priority alerts go to the mock notifier
# (recorded in the outbox table, nothing leaves the machine).
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=

HOST=127.0.0.1
PORT=8000
